#!/usr/bin/env python3
"""odysseus-backup — snapshot + restore of the data directory.

Backs up everything the app keeps under `data/`: the SQLite DB, the
Fernet key, JSON state files, RAG indexes, personal docs, attachments,
WhatsApp session, etc. Output is a gzip tarball — composable with cron
+ scp + s3cmd. SQLite files use verified read-only `.backup()` snapshots. Stop writers for a
coherent snapshot across databases and mutable files. Archives are not encrypted.

    odysseus-backup snapshot                       # → backups/YYYY-MM-DD-HHMMSS.tar.gz
    odysseus-backup snapshot --out /mnt/nas/x.tgz
    odysseus-backup list                           # entries in backups/
    odysseus-backup restore PATH [--yes]           # overwrite current data/ from a tarball
    odysseus-backup verify PATH                    # tarball integrity check (no extract)

Restore replaces `data/` and requires explicit `--yes`. The previous tree is
retained privately for rollback; stop all writers before restoring.
"""

from __future__ import annotations
import sys
import os, sys
sys.path.insert(0, os.path.join(os.path.dirname(__file__), "_lib"))
from cli import quiet_logs, emit, fail, common_parser, run, REPO_ROOT as _REPO_ROOT
quiet_logs()

import argparse, json, logging, os, re, shutil, sqlite3, stat, subprocess, sys, tarfile, tempfile, time
from datetime import datetime
from pathlib import Path, PurePosixPath

_DATA_DIR = _REPO_ROOT / "data"
_BACKUP_DIR = _REPO_ROOT / "backups"

def _sqlite_safe_copy(src: Path, dst: Path) -> None:
    """Fail closed if a SQLite snapshot cannot be made and verified.

    Read-only URI mode must not create a missing source database. Raw copying
    a busy/corrupt SQLite file is never a safe fallback.
    """
    from contextlib import closing
    resolved = src.resolve(strict=True)
    resolved.relative_to(_DATA_DIR.resolve(strict=True))
    with _open_source(src) as guard:
        before = os.fstat(guard.fileno())
    with closing(sqlite3.connect(src.resolve().as_uri() + "?mode=ro", uri=True)) as source:
        with closing(sqlite3.connect(str(dst))) as target:
            started = time.monotonic()
            def progress(status, remaining, total):
                if time.monotonic() - started > 30:
                    raise TimeoutError("SQLite backup exceeded 30 seconds")
            source.backup(target, pages=256, progress=progress, sleep=0.05)
            if target.execute("PRAGMA quick_check").fetchall() != [("ok",)]:
                raise RuntimeError("SQLite backup integrity check failed")
    if src.resolve(strict=True) != resolved:
        raise RuntimeError("Database path changed during backup")
    after = src.stat()
    if src.is_symlink() or (before.st_dev, before.st_ino) != (after.st_dev, after.st_ino):
        raise RuntimeError("Database changed identity during backup")
    dst.chmod(0o600)


def _reject_output_inside_data(out_path: Path) -> None:
    try:
        out_path.resolve().relative_to(_DATA_DIR.resolve())
    except ValueError:
        return
    fail("backup output path must be outside data/")


def _source_files():
    """Never follow a file or directory link out of the local data tree."""
    if _DATA_DIR.is_symlink():
        fail("data directory must not be a symbolic link")
    for folder, directories, names in os.walk(_DATA_DIR, followlinks=False):
        directories[:] = sorted(name for name in directories
                                if not (Path(folder) / name).is_symlink())
        for name in sorted(names):
            path = Path(folder) / name
            if path.is_file() and not path.is_symlink():
                yield path


def _open_source(path):
    """Open each component without following links, including a swapped parent."""
    relative = path.relative_to(_DATA_DIR)
    directory_fd = os.open(_DATA_DIR, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        for component in relative.parts[:-1]:
            next_fd = os.open(component, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                              dir_fd=directory_fd)
            os.close(directory_fd)
            directory_fd = next_fd
        fd = os.open(relative.name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=directory_fd)
    finally:
        os.close(directory_fd)
    if not stat.S_ISREG(os.fstat(fd).st_mode):
        os.close(fd)
        raise RuntimeError("Backup source is not a regular file")
    return os.fdopen(fd, "rb")


def _is_sqlite(path):
    with _open_source(path) as stream:
        header = stream.read(16)
    return path.suffix.lower() in {".db", ".sqlite", ".sqlite3"} or header == b"SQLite format 3\x00"


def _private_directory(path):
    if path.is_symlink():
        fail("backup directory must not be a symbolic link")
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    # Do not chmod an operator's existing shared destination; archives themselves
    # are always owner-only. The default backups directory is made private below.


def _retention(out_path, keep):
    if keep is None:
        return 0
    candidates = []
    for path in out_path.parent.iterdir():
        if (re.fullmatch(r"odysseus-backup-\d{8}-\d{6}-\d{6}\.tar\.gz", path.name)
                and path.is_file() and not path.is_symlink()
                and path.stat().st_uid == os.getuid()):
            candidates.append(path)
    candidates.sort(key=lambda path: path.name, reverse=True)
    removed = 0
    for path in candidates[keep:]:
        if path != out_path:
            path.unlink()
            removed += 1
    return removed


def cmd_snapshot(args):
    """Stream a private, atomic archive, with verified SQLite snapshots.

    Databases are consistent individually. Stop writers for a single coherent
    snapshot across multiple databases, attachments and other mutable files.
    """
    if not _DATA_DIR.is_dir():
        fail(f"no data dir at {_DATA_DIR}")
    keep = getattr(args, "keep", None)
    if keep is not None and (not 1 <= keep <= 365 or args.out):
        fail("--keep must be 1–365 and requires the default timestamped filename")
    _private_directory(_BACKUP_DIR)
    _BACKUP_DIR.chmod(0o700)
    out_path = Path(args.out).absolute() if args.out else (
        _BACKUP_DIR / f"odysseus-backup-{datetime.now().strftime('%Y%m%d-%H%M%S-%f')}.tar.gz"
    )
    _reject_output_inside_data(out_path)
    _private_directory(out_path.parent)
    if out_path.exists() or out_path.is_symlink():
        fail("backup output already exists; choose a new filename")
    include_env = bool(getattr(args, "include_env", False))
    environment = _REPO_ROOT / ".env"
    if include_env and (not environment.is_file() or environment.is_symlink()):
        fail("--include-env requires a regular local .env file")
    paths = [p for p in _source_files()
             if (args.include_research or "deep_research" not in p.relative_to(_DATA_DIR).parts)
             and (args.include_attachments or "mail-attachments" not in p.relative_to(_DATA_DIR).parts)]
    files_added = total_bytes = sqlite_count = 0
    temporary_output = None
    try:
        with tempfile.TemporaryDirectory(prefix="exodus-backup-") as temporary:
            tmp = Path(temporary)
            db_map = {}
            for path in paths:
                if _is_sqlite(path):
                    staged = tmp / path.relative_to(_DATA_DIR)
                    staged.parent.mkdir(parents=True, mode=0o700, exist_ok=True)
                    _sqlite_safe_copy(path, staged)
                    db_map[path] = staged
            sqlite_count = len(db_map)
            sidecars = {Path(str(path) + suffix) for path in db_map
                        for suffix in ("-wal", "-shm", "-journal")}
            fd, filename = tempfile.mkstemp(prefix=".exodus-backup-", suffix=".partial", dir=out_path.parent)
            temporary_output = Path(filename)
            with os.fdopen(fd, "wb") as output:
                os.fchmod(output.fileno(), 0o600)
                with tarfile.open(fileobj=output, mode="w:gz") as tar:
                    root = tarfile.TarInfo("data")
                    root.type, root.mode = tarfile.DIRTYPE, 0o700
                    tar.addfile(root)
                    if include_env:
                        fd = os.open(environment, os.O_RDONLY | os.O_NOFOLLOW)
                        with os.fdopen(fd, "rb") as stream:
                            before = os.fstat(stream.fileno())
                            if not stat.S_ISREG(before.st_mode):
                                raise RuntimeError("Environment backup requires a regular file")
                            info = tarfile.TarInfo(".env")
                            info.size, info.mtime, info.mode = before.st_size, before.st_mtime, 0o600
                            tar.addfile(info, stream)
                            after = os.fstat(stream.fileno())
                            if (before.st_size, before.st_mtime_ns) != (after.st_size, after.st_mtime_ns):
                                raise RuntimeError("Environment changed during backup; retry")
                            files_added += 1
                            total_bytes += info.size
                    for path in paths:
                        if path in sidecars:
                            continue
                        source = db_map.get(path)
                        stream = source.open("rb") if source else _open_source(path)
                        with stream:
                            before = os.fstat(stream.fileno())
                            info = tarfile.TarInfo(str(Path("data") / path.relative_to(_DATA_DIR)))
                            info.size, info.mtime, info.mode = before.st_size, before.st_mtime, 0o600
                            tar.addfile(info, stream)
                            after = os.fstat(stream.fileno())
                            if (before.st_size, before.st_mtime_ns) != (after.st_size, after.st_mtime_ns):
                                raise RuntimeError("A data file changed during backup; retry while writers are stopped")
                            files_added += 1
                            total_bytes += info.size
                output.flush()
                os.fsync(output.fileno())
            # Atomic no-clobber publication. A concurrently created filename or
            # symlink cannot be overwritten. Temp and final are on one filesystem.
            os.link(temporary_output, out_path)
    finally:
        if temporary_output is not None:
            temporary_output.unlink(missing_ok=True)
    removed = _retention(out_path, keep)
    emit({
        "ok": True, "path": str(out_path), "files": files_added,
        "sqlite_snapshots": sqlite_count, "uncompressed_bytes": total_bytes,
        "compressed_bytes": out_path.stat().st_size,
        "ratio": round(out_path.stat().st_size / max(total_bytes, 1), 4),
        "included_research": bool(args.include_research),
        "included_attachments": bool(args.include_attachments),
        "retention_removed": removed, "included_environment": include_env,
    }, args)


def cmd_list(args):
    """List entries in `backups/`. Most recent first."""
    if not _BACKUP_DIR.is_dir():
        emit([], args)
        return
    entries = []
    for p in _BACKUP_DIR.iterdir():
        entry = _backup_entry(p)
        if entry is not None:
            entries.append(entry)
    entries.sort(key=lambda entry: entry["_mtime"], reverse=True)
    for entry in entries:
        entry.pop("_mtime", None)
    emit(entries, args)


def _backup_entry(p):
    try:
        if not p.is_file():
            return None
        st = p.stat()
    except OSError:
        return None
    return {
        "path": str(p),
        "name": p.name,
        "bytes": st.st_size,
        "modified": datetime.fromtimestamp(st.st_mtime).isoformat(),
        "_mtime": st.st_mtime,
    }


def cmd_verify(args):
    """Open the tarball read-only and walk its members — confirms
    integrity without extracting anything."""
    path = Path(args.path)
    if not path.exists():
        fail(f"no file at {path}")
    try:
        with tarfile.open(path, "r:gz") as tar:
            members = tar.getmembers()
            _validate_restore_members(members)
            # Read payloads as well as headers to validate truncated streams/CRC.
            for member in members:
                if member.isfile():
                    with tar.extractfile(member) as stream:
                        while stream.read(1024 * 1024):
                            pass
    except (tarfile.TarError, OSError, EOFError) as e:
        fail(f"tarball is corrupt: {e}")
    emit({
        "ok": True,
        "path": str(path),
        "members": len(members),
        "first": members[0].name if members else None,
        "last": members[-1].name if members else None,
    }, args)


def _validate_restore_members(members):
    """Reject archive entries that can escape data/ during restore."""
    seen = set()
    for m in members:
        rel = PurePosixPath(m.name)
        if str(rel) in seen:
            fail("refusing tarball with duplicate paths")
        seen.add(str(rel))
        if rel.is_absolute() or ".." in rel.parts:
            fail(f"refusing tarball with absolute/parent path: {m.name!r}")
        environment_file = rel.parts == (".env",) and m.isfile()
        if not environment_file and (not rel.parts or rel.parts[0] != "data"):
            fail(f"refusing tarball with entry outside data/: {m.name!r}")
        if m.issym() or m.islnk():
            fail(f"refusing tarball with link entry: {m.name!r}")
        if not (m.isdir() or m.isfile()):
            fail(f"refusing tarball with special file entry: {m.name!r}")


def _extract_restore_members(tar, members, root: Path) -> None:
    """Extract only regular files/directories after validation."""
    for m in members:
        target = root.joinpath(*PurePosixPath(m.name).parts)
        if m.isdir():
            target.mkdir(mode=0o700, parents=True, exist_ok=True)
            target.chmod(0o700)
            continue
        target.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        src = tar.extractfile(m)
        if src is None:
            fail(f"extract failed: could not read {m.name!r}")
        with src, open(target, "xb") as dst:
            os.fchmod(dst.fileno(), 0o600)
            shutil.copyfileobj(src, dst, length=1024 * 1024)
        os.utime(target, (m.mtime, m.mtime))
    for folder, directories, _ in os.walk(root):
        Path(folder).chmod(0o700)


def cmd_restore(args):
    """Replace `data/` after full staging, retaining the old tree; requires --yes."""
    path = Path(args.path)
    if not path.exists():
        fail(f"no file at {path}")
    if not args.yes:
        fail("restore is destructive — pass --yes to confirm overwriting data/")
    # Sanity check: tarball entries must all be safe, regular files/dirs under
    # `data/`. Avoid extractall() so symlink/hardlink entries can't redirect a
    # later write outside the repo.
    stash = environment_stash = None
    restore_env = bool(getattr(args, "restore_env", False))
    environment = _REPO_ROOT / ".env"
    restored_environment = False
    # Fully validate/extract into private staging before touching current data.
    # Failed extraction therefore leaves the live tree exactly where it was.
    with tempfile.TemporaryDirectory(prefix=".exodus-restore-", dir=_REPO_ROOT) as temporary:
        stage = Path(temporary)
        with tarfile.open(path, "r:gz") as tar:
            members = tar.getmembers()
            _validate_restore_members(members)
            if restore_env and not any(m.name == ".env" for m in members):
                fail("archive does not contain .env")
            (stage / "data").mkdir(mode=0o700)
            _extract_restore_members(tar, members, stage)
        if _DATA_DIR.is_symlink() or (restore_env and environment.is_symlink()):
            fail("refusing to replace a symbolic-link data directory or environment file")
        stamp = datetime.now().strftime('%Y%m%d-%H%M%S-%f')
        try:
            if _DATA_DIR.exists():
                stash = _REPO_ROOT / f"data.before-restore-{stamp}"
                os.rename(_DATA_DIR, stash)
            if restore_env:
                if environment.exists():
                    environment_stash = _REPO_ROOT / f".env.before-restore-{stamp}"
                    os.rename(environment, environment_stash)
                    environment_stash.chmod(0o600)
                os.rename(stage / ".env", environment)
                restored_environment = True
            os.rename(stage / "data", _DATA_DIR)
        except BaseException:
            if restored_environment:
                environment.unlink()
            if environment_stash is not None and environment_stash.exists():
                os.rename(environment_stash, environment)
            if stash is not None and stash.exists():
                os.rename(stash, _DATA_DIR)
            raise
    emit({
        "ok": True,
        "restored_from": str(path),
        "previous_data_stashed_at": str(stash) if stash else None,
        "environment_restored": restored_environment,
        "previous_environment_stashed_at": str(environment_stash) if environment_stash else None,
    }, args)


def _build_parser():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--pretty", action="store_true")
    p = argparse.ArgumentParser(prog="odysseus-backup", parents=[common])
    sub = p.add_subparsers(dest="cmd", required=True)

    ps = sub.add_parser("snapshot", parents=[common])
    ps.add_argument("--out", help="output path (default: backups/<timestamp>.tar.gz)")
    ps.add_argument("--include-research", action="store_true",
                    help="include data/deep_research/ (skipped by default; large)")
    ps.add_argument("--include-attachments", action="store_true",
                    help="include data/mail-attachments/ (skipped by default; re-derivable)")
    ps.add_argument("--include-env", action="store_true", help="include the ignored local .env; archive contains secrets and is not encrypted")
    ps.add_argument("--keep", type=int, help="explicitly retain 1–365 newest CLI timestamped backups; never used by default")
    ps.set_defaults(func=cmd_snapshot)

    pl = sub.add_parser("list", parents=[common])
    pl.set_defaults(func=cmd_list)

    pv = sub.add_parser("verify", parents=[common])
    pv.add_argument("path")
    pv.set_defaults(func=cmd_verify)

    pr = sub.add_parser("restore", parents=[common])
    pr.add_argument("path")
    pr.add_argument("--yes", action="store_true",
                    help="confirm overwriting current data/")
    pr.add_argument("--restore-env", action="store_true", help="also replace .env from a snapshot created with --include-env (old .env retained)")
    pr.set_defaults(func=cmd_restore)

    return p


if __name__ == "__main__":
    sys.exit(run(_build_parser()))
