venv/
.venv/
node_modules/
services/node_modules/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.env
.env.bak.*
# Secrets: keep plaintext and every transient secrets.env variant out of
# the build context. If an encrypted secrets.env is used, it is mounted
# at runtime — never baked into the image. Mirrored in .gitignore.
secrets.env
secrets.env.*
secrets.env~
.secrets.env.swp
.secrets.env.swo
**/#secrets.env#
!secrets.env.example
/data/
/logs/
.git/
.claude/
.playwright-mcp/
.pytest_cache/
.vscode/
.idea/
dev-docs/
docs/
website/
assets/branding/
*.md
*.db
*.sqlite
*.sqlite3
/reports/
/research_data/
tasks/
_scratch/
compound.config.json
search_analytics.json
**/search_analytics.json
tests/
api/
*.log
*.error.log
chart.png
timetree*.png
*_signin_page.png
*_calendar_view.png
.gitignore

# Local secrets and consistent data backups never enter image builds.
.env*
!/.env.example
**/data/
backups/
# Private data retained/staged by the local restore command (root only).
/data.before-restore-*/
/.exodus-restore-*/
# Include distribution notices despite the general documentation exclusion.
!ACKNOWLEDGMENTS.md
!services/hwfit/data/README.md

# Rust build output for native/ engines (e.g. the Calculator). The compiled
# WebAssembly that Exodus serves is committed under static/; the image never
# needs the local cargo build folder.
native/*/target/
