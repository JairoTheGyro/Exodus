{
    admin off
    auto_https off
    log {
        # Error logs can otherwise contain notification access-token queries.
        output discard
    }
}

# Optional local HTTPS. The browser must already trust the supplied certificate;
# no trust bypass or automatic root installation is performed by Exodus.
:8080 {
    tls /run/tls/cert.pem /run/tls/key.pem
    route {
        @untrusted not host localhost 127.0.0.1 [::1]
        respond @untrusted "Local vault host required" 421
        header {
            -Server
            X-Content-Type-Options nosniff
            Referrer-Policy no-referrer
            Cache-Control "no-store"
            # HSTS applies across ports. Do not pin all localhost apps (including
            # Exodus's HTTP port) to HTTPS; use a dedicated hostname before
            # enabling a long-lived production HSTS policy.
            Strict-Transport-Security "max-age=0"
        }
        redir / /vault/ 308
        redir /vault /vault/ 308
        handle /vault/* {
            reverse_proxy vaultwarden:8080 {
                header_up Cookie "VW_ADMIN={http.request.cookie.VW_ADMIN}"
            }
        }
        respond "Not found" 404
    }
}

# This port is never published to the host. Serve ONLY the fixed health route,
# so internal HTTP polling cannot become an alternate plaintext vault entrance.
http://:8081 {
    route {
        @health {
            host localhost 127.0.0.1 [::1]
            method GET
            path /vault/alive
        }
        handle @health {
            reverse_proxy vaultwarden:8080 {
                header_up -Cookie
                header_up -Authorization
                header_down -Strict-Transport-Security
            }
        }
        respond "Not found" 404
    }
}
